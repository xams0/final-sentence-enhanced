<Window x:Class="Lanppart3Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanppart3 Final Sentence" Width="1440" Height="840" MinWidth="960" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0D0907" FontFamily="{StaticResource GameFont}" Icon="Assets/icon.ico"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        MouseLeftButtonDown="OnDragWindow" Closing="OnClosing">
  <!-- Borderless, but resizable from its edges. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <!-- The main menu's room, dimmed where the text goes. -->
    <Image Source="Assets/background.jpg" Stretch="UniformToFill" />
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#F20D0907" Offset="0" />
          <GradientStop Color="#E00D0907" Offset="0.55" />
          <GradientStop Color="#B80D0907" Offset="0.68" />
          <GradientStop Color="#EE0D0907" Offset="0.74" />
          <GradientStop Color="#F50D0907" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- The whole layout is drawn at 1440 x 840 and scaled to the window: text grows with it. -->
    <Viewbox Stretch="Uniform">
      <Grid Width="1440" Height="840">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title and tabs. -->
        <Grid Grid.Row="0">
          <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Border Background="{StaticResource TitleRed}" Padding="5,0,5,0" CornerRadius="1">
                <TextBlock Text="F" FontSize="34" Foreground="{StaticResource Cream}" />
              </Border>
              <TextBlock Text="inal " FontSize="34" Foreground="{StaticResource Cream}" Margin="2,0,0,0" />
              <Border Background="{StaticResource TitleRed}" Padding="5,0,5,0" CornerRadius="1" Margin="10,0,0,0">
                <TextBlock Text="S" FontSize="34" Foreground="{StaticResource Cream}" />
              </Border>
              <TextBlock Text="entence" FontSize="34" Foreground="{StaticResource Cream}" Margin="2,0,0,0" />
            </StackPanel>
            <TextBlock Text="L A N P P A R T 3" FontSize="16" Foreground="{StaticResource Caption}"
                       HorizontalAlignment="Center" Margin="0,4,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="TabPlay" Style="{StaticResource TabButton}" Content="JOUER" Click="OnTabPlay" />
              <Button x:Name="TabServer" Style="{StaticResource TabButton}" Content="SERVEUR" Click="OnTabServer" />
              <Button x:Name="TabInfo" Style="{StaticResource TabButton}" Content="INFOS" Click="OnTabInfo" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
            <Button Style="{StaticResource WindowButton}" Content="_" Click="OnMinimize" ToolTip="Réduire" />
            <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="□" Click="OnMaximize" ToolTip="Agrandir" />
            <Button Style="{StaticResource WindowButton}" Content="X" Click="OnQuit" ToolTip="Fermer" />
          </StackPanel>
        </Grid>
        <Rectangle Grid.Row="0" Style="{StaticResource HLine}" VerticalAlignment="Bottom" />

        <!-- An outdated launcher can't start the game: the update comes first, whatever the tab. -->
        <Border x:Name="UpdatePanel" Grid.Row="1" Visibility="Collapsed" Background="#66C8692A"
                BorderBrush="{StaticResource Frame}" BorderThickness="0,0,0,1" Padding="40,8,40,8">
          <DockPanel>
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                    Content="Installer la mise à jour" Click="OnUpdate" />
            <TextBlock x:Name="UpdateText" FontSize="18" Foreground="{StaticResource Cream}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Une nouvelle version du lanceur est disponible : installez-la pour jouer." />
          </DockPanel>
        </Border>

        <!-- Body: the tab's page on the left, the tab's menu on the right. -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <Grid Margin="48,20,36,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" FontSize="30" Foreground="{StaticResource Cream}" />
            <Rectangle Grid.Row="1" Style="{StaticResource HLine}" Width="140" HorizontalAlignment="Left" Margin="0,10,0,16"
                       Opacity="0.9" Height="2" />
            <ContentControl x:Name="PageHost" Grid.Row="2" />
          </Grid>

          <Rectangle Grid.Column="1" Style="{StaticResource VLine}" Margin="0,20,0,20" />

          <DockPanel Grid.Column="2" Margin="26,20,30,14" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="MenuTitle" FontSize="30" Foreground="{StaticResource Caption}" />
              <TextBlock x:Name="MenuText" FontSize="15" Foreground="{StaticResource CreamDim}" TextWrapping="Wrap"
                         Margin="0,4,0,0" LineHeight="21" LineStackingStrategy="BlockLineHeight" />
              <Rectangle Style="{StaticResource HLine}" Margin="0,14,0,8" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource MenuEntry}" Content="Quitter" Click="OnQuit" />
            <Rectangle DockPanel.Dock="Bottom" Style="{StaticResource HLine}" Margin="0,8,0,8" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="MenuHost" />
            </ScrollViewer>
          </DockPanel>
        </Grid>

        <!-- Footer: what the launcher is doing, the game and the mod. -->
        <Border Grid.Row="3" BorderBrush="{StaticResource FrameDim}" BorderThickness="0,1,0,0" Padding="48,10,30,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="StatusText" FontSize="18" Foreground="{StaticResource Caption}" TextWrapping="Wrap" />
              <TextBlock x:Name="GameText" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="14" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Bottom" Margin="24,0,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</Window>

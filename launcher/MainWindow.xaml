<Window x:Class="Lanppart3Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanppart3 Final Sentence" Width="1300" Height="800"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#0D0907" FontFamily="{StaticResource GameFont}" Icon="Assets/icon.ico"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        MouseLeftButtonDown="OnDragWindow" Closing="OnClosing">
  <Grid>
    <!-- The main menu's room, dimmed on the sides where the text goes (like the game's menu). -->
    <Image Source="Assets/background.jpg" Stretch="UniformToFill" />
    <Rectangle x:Name="Dimmer">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#F00D0907" Offset="0" />
          <GradientStop Color="#C00D0907" Offset="0.38" />
          <GradientStop Color="#550D0907" Offset="0.55" />
          <GradientStop Color="#C80D0907" Offset="0.68" />
          <GradientStop Color="#F00D0907" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- Pages need the whole left side readable. -->
    <Rectangle x:Name="PageDimmer" Visibility="Collapsed">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#F00D0907" Offset="0" />
          <GradientStop Color="#E00D0907" Offset="0.66" />
          <GradientStop Color="#C80D0907" Offset="0.72" />
          <GradientStop Color="#F00D0907" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#A00D0907" Offset="0" />
          <GradientStop Color="#000D0907" Offset="0.22" />
          <GradientStop Color="#000D0907" Offset="0.75" />
          <GradientStop Color="#E00D0907" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Title: "Final Sentence" with the capitals on red, as on the game's menu. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Border Background="{StaticResource TitleRed}" Padding="5,0,5,0" CornerRadius="1">
          <TextBlock Text="F" FontSize="34" Foreground="{StaticResource Cream}" />
        </Border>
        <TextBlock Text="inal " FontSize="34" Foreground="{StaticResource Cream}" Margin="2,0,0,0" />
        <Border Background="{StaticResource TitleRed}" Padding="5,0,5,0" CornerRadius="1" Margin="10,0,0,0">
          <TextBlock Text="S" FontSize="34" Foreground="{StaticResource Cream}" />
        </Border>
        <TextBlock Text="entence" FontSize="34" Foreground="{StaticResource Cream}" Margin="2,0,0,0" />
      </StackPanel>
      <TextBlock Text="L A N P P A R T 3" FontSize="17" Foreground="{StaticResource Caption}"
                 HorizontalAlignment="Center" Margin="0,6,0,0" />
    </StackPanel>

    <!-- Window controls -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
      <Button Style="{StaticResource WindowButton}" Content="_" Click="OnMinimize" ToolTip="Réduire" />
      <Button Style="{StaticResource WindowButton}" Content="X" Click="OnQuit" ToolTip="Fermer" />
    </StackPanel>

    <!-- Left: what the pointed entry does. -->
    <StackPanel x:Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,175,0,0" Width="460">
      <TextBlock x:Name="InfoTitle" FontSize="30" Foreground="{StaticResource Cream}" TextWrapping="Wrap" />
      <Rectangle Height="2" Fill="{StaticResource Frame}" Width="120" HorizontalAlignment="Left" Margin="0,12,0,16" Opacity="0.8" />
      <TextBlock x:Name="InfoText" FontSize="16.5" Foreground="{StaticResource CreamDim}" TextWrapping="Wrap"
                 LineHeight="25" LineStackingStrategy="BlockLineHeight" />
    </StackPanel>

    <!-- Left: pages (servers, server browser, custom texts). -->
    <Grid x:Name="PagePanel" Margin="50,115,440,108" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="PageTitle" FontSize="28" Foreground="{StaticResource Cream}" />
        <Button Style="{StaticResource PlainButton}" Content="× Fermer" FontSize="15" Margin="24,6,0,0"
                VerticalAlignment="Center" Click="OnClosePage" />
      </StackPanel>
      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,14,0,0" />
    </Grid>

    <!-- Right: the menu, laid out like the game's. -->
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,128,60,0" Width="360">
      <!-- An outdated launcher can't start the game: the update comes first. -->
      <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" Margin="0,0,0,14">
        <TextBlock Text="Mise à jour" Style="{StaticResource SectionCaption}" />
        <Button x:Name="UpdateButton" Style="{StaticResource MenuEntry}" Content="Installer la mise à jour" Click="OnUpdate" />
      </StackPanel>
      <TextBlock Text="Lancer le jeu" Style="{StaticResource SectionCaption}" />
      <Button x:Name="NormalButton" Style="{StaticResource MenuEntry}" Content="Mode normal"
              Click="OnLaunchNormal" MouseEnter="OnPointNormal" GotKeyboardFocus="OnPointNormal" />
      <Button x:Name="ModButton" Style="{StaticResource MenuEntry}" Content="Mode Lanppart3"
              Click="OnLaunchLanppart" MouseEnter="OnPointLanppart" GotKeyboardFocus="OnPointLanppart" />

      <TextBlock Text="Serveurs LAN" Style="{StaticResource SectionCaption}" Margin="0,20,0,6" />
      <Button x:Name="BrowserButton" Style="{StaticResource MenuEntry}" Content="Rejoindre un serveur"
              Click="OnShowBrowser" MouseEnter="OnPointBrowser" GotKeyboardFocus="OnPointBrowser" />
      <Button x:Name="HostButton" Style="{StaticResource MenuEntry}" Content="Héberger un serveur"
              Click="OnShowServers" MouseEnter="OnPointServers" GotKeyboardFocus="OnPointServers" />
      <Button Style="{StaticResource MenuEntry}" Content="Textes personnalisés"
              Click="OnShowTexts" MouseEnter="OnPointTexts" GotKeyboardFocus="OnPointTexts" />

      <TextBlock Text="Informations" Style="{StaticResource SectionCaption}" Margin="0,20,0,6" />
      <Button Style="{StaticResource MenuEntry}" Content="Pourquoi deux modes ?"
              Click="OnPointWhy" MouseEnter="OnPointWhy" GotKeyboardFocus="OnPointWhy" />
      <Button Style="{StaticResource MenuEntry}" Content="Jouer en Lanppart3"
              Click="OnPointHowTo" MouseEnter="OnPointHowTo" GotKeyboardFocus="OnPointHowTo" />
      <Button x:Name="FolderButton" Style="{StaticResource MenuEntry}" Content="Dossier du jeu"
              Click="OnGameFolder" MouseEnter="OnPointFolder" GotKeyboardFocus="OnPointFolder" />

      <Button Style="{StaticResource TopEntry}" Content="Quitter" Margin="-18,22,0,0" Click="OnQuit" />
    </StackPanel>

    <!-- Bottom left: state of the game and the mod. -->
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,40" Width="760">
      <TextBlock x:Name="StatusText" FontSize="17" Foreground="{StaticResource Caption}" TextWrapping="Wrap" />
      <TextBlock x:Name="GameText" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock x:Name="VersionText" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="12"
               Foreground="{StaticResource Muted}" />
  </Grid>
</Window>
